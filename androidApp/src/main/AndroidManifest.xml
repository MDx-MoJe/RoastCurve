<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 设备通信：WiFi (WebSocket / MODBUS TCP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- mDNS 桥接器自动发现（roastbridge.local）需多播接收 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 烘焙会话前台保活：锁屏/切后台不断采集不被杀 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 蓝牙 BLE（可选链路，仅用户主动进入配网页时申请）
         neverForLocation 明确声明不通过 BLE 推断位置，因此不需要任何定位权限。
         Android 11 及以下按系统要求仍以 ACCESS_FINE_LOCATION 作为 BLE 扫描的运行时权限，
         但那属于旧系统机制；本应用不读取、不存储、不上传任何位置信息。 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 及以下才生效（12+ 系统自动忽略） -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- 仅 Android 11 及以下作为 BLE 扫描的必要权限（系统机制），12+ 完全不声明。
         用途仅为发现烘焙桥接器，不用于获取位置。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- USB 串口（预留直连路径） -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- 豆袋互联：跨应用调用豆袋的生豆库存接口 -->
    <uses-permission android:name="com.coffee.beantracker.permission.BRIDGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.roastcurve.app.platform.RoastKeepService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>